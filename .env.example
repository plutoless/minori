NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://user:password@host/database?sslmode=require

FEISHU_APP_ID=cli_example
FEISHU_APP_SECRET=replace-me
FEISHU_BOT_OPEN_ID=ou_example
# Feishu App availability and delivered events are the sole conversation admission boundary.

OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://example-compatible-service.invalid/v1
AI_MODEL=5.6-terra
AGENT_MAX_STEPS=40
AGENT_TIMEOUT_MS=300000
CONVERSATION_CONTEXT_TOKEN_TARGET=24000
MESSAGE_RETENTION_DAYS=30
TEAM_CONTEXT_DOCUMENT_TOKEN=dox_team_context
TEAM_CONTEXT_TOKEN_BUDGET=8000
TEAM_CONTEXT_STALE_MAX_MS=86400000

LARK_CLI_BIN=lark-cli
# For local OAuth, replace these with absolute operator-writable directories.
LARKSUITE_CLI_CONFIG_DIR=/var/lib/minori/lark/config
LARKSUITE_CLI_DATA_DIR=/var/lib/minori/lark/data
