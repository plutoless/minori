#!/bin/bash
set -euo pipefail
umask 077
LC_ALL=C
LANG=C
IFS=$' \t\n'
unset BASH_ENV ENV CDPATH
export LC_ALL LANG IFS

emit_and_exit() {
  printf 'minori_deploy result=%s\n' "$1"
  exit "$2"
}

emit_active_and_exit() {
  printf 'minori_deploy result=%s active_sha=%s active_image=%s\n' "$1" "$2" "$3"
  exit "$4"
}

if [[ $# -ne 0 ]]; then
  emit_and_exit rejected 2
fi

original_command="${SSH_ORIGINAL_COMMAND-}"
command_pattern='^deploy v1 ([0123456789abcdef]{40}) (ghcr\.io/plutoless/minori@sha256:[0123456789abcdef]{64})$'
if [[ ! "$original_command" =~ $command_pattern ]]; then
  emit_and_exit rejected 2
fi

protocol='v1'
commit_sha="${BASH_REMATCH[1]}"
image="${BASH_REMATCH[2]}"
installed_entrypoint='/opt/minori/libexec/ci-deploy'
test_mode=0
if [[ "${BASH_SOURCE[0]}" == "$installed_entrypoint" && "${MINORI_CLEAN_ENTRYPOINT:-}" == ci-deploy ]]; then
  PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
  export PATH
  minori_root='/opt/minori'
  lock_file='/run/lock/minori-ci-deploy.lock'
elif [[ -n "${MINORI_TEST_ROOT:-}" && -d "$MINORI_TEST_ROOT" && -O "$MINORI_TEST_ROOT" ]]; then
  test_mode=1
  minori_root="$MINORI_TEST_ROOT"
  lock_file="${MINORI_DEPLOY_LOCK_FILE:-${minori_root}/ci-deploy.lock}"
else
  emit_and_exit rejected 2
fi

open_lock_file() {
  exec 9>"$lock_file"
}
if ! open_lock_file 2>/dev/null; then
  emit_and_exit failed 1
fi
if ! flock -n 9 2>/dev/null; then
  emit_and_exit locked 75
fi

release_output=''
release_status=0
if [[ $test_mode -eq 1 ]]; then
  release_command=("${minori_root}/bin/minori-release")
else
  release_command=(/opt/minori/bin/minori-release)
fi
set +e
release_output="$("${release_command[@]}" \
  "$protocol" "$commit_sha" "$image" 2>/dev/null)"
release_status=$?
set -e
if [[ $release_status -eq 0 ]]; then
  success_pattern='^minori_release result=success active_sha=([0123456789abcdef]{40}) active_image=(ghcr\.io/plutoless/minori@sha256:[0123456789abcdef]{64})$'
  if [[ "$release_output" =~ $success_pattern \
    && "${BASH_REMATCH[1]}" == "$commit_sha" && "${BASH_REMATCH[2]}" == "$image" ]]; then
    emit_active_and_exit success "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" 0
  fi
  emit_and_exit failed 1
fi
rollback_pattern='^minori_release result=rolled_back active_sha=([0123456789abcdef]{40}) active_image=(ghcr\.io/plutoless/minori@sha256:[0123456789abcdef]{64}|minori:[0123456789abcdef]{40})$'
failed_before_pattern='^minori_release result=failed_before_replace active_sha=([0123456789abcdef]{40}) active_image=(ghcr\.io/plutoless/minori@sha256:[0123456789abcdef]{64}|minori:[0123456789abcdef]{40})$'
if [[ $release_status -eq 1 && "$release_output" =~ $rollback_pattern ]]; then
  active_sha="${BASH_REMATCH[1]}"
  active_image="${BASH_REMATCH[2]}"
  if [[ "$active_image" != minori:* || "${active_image#minori:}" == "$active_sha" ]]; then
    emit_active_and_exit rolled_back "$active_sha" "$active_image" 1
  fi
  emit_and_exit failed 1
fi
if [[ $release_status -eq 1 && "$release_output" =~ $failed_before_pattern ]]; then
  active_sha="${BASH_REMATCH[1]}"
  active_image="${BASH_REMATCH[2]}"
  if [[ "$active_image" != minori:* || "${active_image#minori:}" == "$active_sha" ]]; then
    emit_active_and_exit failed_before_replace "$active_sha" "$active_image" 1
  fi
  emit_and_exit failed 1
fi
[[ $release_status -eq 1 ]] || emit_and_exit failed 1
case "$release_output" in
  'minori_release result=rollback_failed') emit_and_exit rollback_failed 1 ;;
  'minori_release result=recovery_failed') emit_and_exit recovery_failed 1 ;;
  *) emit_and_exit failed 1 ;;
esac
