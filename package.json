{
  "name": "minori",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lark:auth": "node --env-file-if-exists=.env --experimental-strip-types scripts/lark-auth.ts",
    "lark:contract-audit": "node --experimental-strip-types scripts/lark-contract-audit.ts",
    "runtime:verify": "node --env-file-if-exists=.env --experimental-strip-types scripts/verify-runtime.ts",
    "db:migrate": "node --env-file-if-exists=.env --experimental-strip-types scripts/migrate.ts",
    "typecheck:scripts": "tsc --ignoreConfig --noEmit --target ES2023 --module NodeNext --moduleResolution NodeNext --strict --esModuleInterop --skipLibCheck --allowImportingTsExtensions --types node scripts/*.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "generate:lark-contract-validators": "node scripts/generate-lark-contract-validators.mjs",
    "check:lark-contract-validators": "node scripts/check-lark-contract-validators.mjs",
    "verify": "npm run generate:lark-contract-validators && npm run check:lark-contract-validators && npm run typecheck && npm run typecheck:scripts && npm test && npm run build"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.30",
    "@larksuite/cli": "^1.0.84",
    "@larksuiteoapi/node-sdk": "^1.72.0",
    "ai": "^7.0.52",
    "cron-parser": "^5.8.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.2",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
